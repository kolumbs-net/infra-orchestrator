# Managed by infra-orchestrator: public route for the {{ slot_name }} service slot.
{% for p in slot_routes %}
{% if p.route_scheme | default('ws') == 'http' %}
ProxyPass "{{ p.route }}" "http://localhost:{{ p.port }}/"
ProxyPassReverse "{{ p.route }}" "http://localhost:{{ p.port }}/"
{% else %}
ProxyPass "{{ p.route }}" "ws://localhost:{{ p.port }}/"
{% endif %}
{% endfor %}
